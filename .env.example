# LLM provider: "openai" or "anthropic"
INGEST_LLM_PROVIDER=openai

# OpenAI (default enrichment provider)
INGEST_OPENAI_API_KEY=sk-...
INGEST_OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternative enrichment provider)
INGEST_ANTHROPIC_API_KEY=sk-ant-...
INGEST_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# LLM concurrency limit
INGEST_LLM_CONCURRENCY=10

# Embedding model (sentence-transformers)
INGEST_EMBEDDING_MODEL=intfloat/e5-large-v2
# Matryoshka truncation dimensions (empty = full)
# INGEST_EMBEDDING_DIMENSIONS=512
# Binary quantization: "none" or "binary"
INGEST_EMBEDDING_QUANTIZATION=none

# Data directory
INGEST_DATA_DIR=data

# Cleaning
INGEST_CLEANING_ENABLED=true

# Chunking
INGEST_MAX_CHUNK_TOKENS=500
INGEST_MIN_CHUNK_TOKENS=100
INGEST_CHUNK_OVERLAP_FRACTION=0.1
# Strategy: "paragraph", "semantic", or "recursive"
INGEST_CHUNKING_STRATEGY=paragraph
INGEST_SEMANTIC_THRESHOLD_PERCENTILE=10
INGEST_CONTEXTUAL_CHUNKING=false

# Knowledge graph: extract entity-relationship triples during enrichment
# Auto-enabled for "paper" and "documentation" profiles regardless of this setting
INGEST_EXTRACT_KNOWLEDGE_GRAPH=false

# Audio/video transcription (requires: pip install ingestible[audio])
# Model: tiny, base, small, medium, large-v3
INGEST_WHISPER_MODEL=base

# Deduplication
INGEST_DEDUP_ENABLED=true

# Checkpoint/resume
INGEST_CHECKPOINT_ENABLED=true

# Search
INGEST_VECTOR_WEIGHT=0.7
INGEST_BM25_WEIGHT=0.3
INGEST_DEFAULT_SEARCH_RESULTS=5
# Cross-encoder reranker (empty = disabled)
# INGEST_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
INGEST_RERANKER_TOP_K=50
INGEST_RERANKER_WEIGHT=0.5

# API authentication (comma-separated keys, empty = no auth)
# INGEST_API_KEYS=key1,key2

# --- Production / Deployment ---

# CORS allowed origins (comma-separated, default: *)
# INGEST_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Rate limiting (requests per minute)
INGEST_RATE_LIMIT_INGEST=10/minute
INGEST_RATE_LIMIT_SEARCH=60/minute
INGEST_RATE_LIMIT_DEFAULT=120/minute

# Upload limits
INGEST_MAX_UPLOAD_BYTES=500000000
INGEST_MAX_CONCURRENT_INGESTIONS=2

# Parse timeout (seconds, for PDF/audio/video)
INGEST_PARSE_TIMEOUT=300

# LLM resilience
INGEST_LLM_TIMEOUT=120
INGEST_LLM_MAX_RETRIES=3
INGEST_LLM_RETRY_BASE_DELAY=1.0

# Batch processing: hard ceiling for total LLM concurrency across parallel workers
INGEST_MAX_TOTAL_LLM_CONCURRENCY=20

# Embedding device: "auto" (cuda > mps > cpu), "cuda", "mps", "cpu"
INGEST_EMBEDDING_DEVICE=auto

# Logging
INGEST_LOG_JSON=true
INGEST_LOG_LEVEL=INFO

# Health check: minimum free disk space (MB)
INGEST_MIN_DISK_SPACE_MB=500

# Searcher cache: max cached document searchers in memory
INGEST_SEARCHER_CACHE_SIZE=50
